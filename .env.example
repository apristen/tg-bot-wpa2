TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE # Visit @BotFather to get your bot's token
ALLOWED_USER_IDS=1234567,345678,... # Know your and others IDs in Telegram: Settings->Advanced->Experimental Settings->Profile->Show Peer IDs in Profile=ON
HASHCAT_LOG_N_LINES=30 # Default 30 , if default ok then remove this line
PROXY_URI=socks5://127.0.0.1:9050 # Put your schame+IP+port or remove this line if no proxy needed
